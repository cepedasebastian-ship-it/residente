---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import SiteNav from '../../components/SiteNav.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import Newsletter from '../../components/Newsletter.astro';
import settings from '../../data/settings.json';

const posts = (await getCollection('posts')).sort(
  (a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime()
);

const formatDate = (date: string) =>
  new Intl.DateTimeFormat('es-AR', { day: '2-digit', month: 'short', year: 'numeric', timeZone: 'UTC' }).format(new Date(date));
---

<Layout
  title={`${settings.journalTitle} — Experiencia Residente`}
  description={settings.journalLabel}
>
  <SiteNav />

  <header class="f-page-hero">
    <span class="f-entry-label">{settings.journalLabel}</span>
    <h1>{settings.journalTitle}</h1>
  </header>

  <section class="f-journal-grid">
    {posts.map((post) => (
      <a class="f-journal-card" href={`/cuaderno/${post.id}`}>
        <div class="f-journal-photo">
          <Image src={post.data.coverImage} alt={post.data.coverAlt} width={400} height={300} />
        </div>
        <span class="f-journal-date">{formatDate(post.data.date)}</span>
        <h3>{post.data.title}</h3>
        <p>{post.data.excerpt}</p>
      </a>
    ))}
  </section>

  <Newsletter />

  <SiteFooter />
</Layout>
