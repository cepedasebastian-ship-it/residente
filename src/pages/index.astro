---
import { getCollection, render } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import TripCard from '../components/TripCard.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
import SiteNav from '../components/SiteNav.astro';
import SiteFooter from '../components/SiteFooter.astro';
import Newsletter from '../components/Newsletter.astro';
import settings from '../data/settings.json';

const trips = (await getCollection('trips')).sort((a, b) => a.data.order - b.data.order);
const featuredTrip = trips.find((t) => t.data.status === 'proximo') ?? trips[0];
const tripsWithContent = await Promise.all(
  trips.map(async (trip) => ({ trip, Content: (await render(trip)).Content }))
);
---

<Layout
  title="Experiencia Residente — viajes para vivir cada lugar como quien ya vive ahí"
  description="Viajes chicos, armados por Romi, para vivir cada destino como residente y no como turista. Próximo viaje: Mendoza, octubre 2026, solo mujeres."
>
  <SiteNav />

  <header class="f-hero">
    <svg class="f-topo" viewBox="0 0 420 260" preserveAspectRatio="none" aria-hidden="true">
      <g fill="none" stroke="var(--f-ink-soft)" stroke-width="1" opacity="0.4">
        <path d="M -10 40 C 90 10, 180 60, 280 30 S 460 0, 520 40" />
        <path d="M -10 80 C 100 50, 190 100, 290 70 S 450 40, 520 80" />
        <path d="M -10 120 C 110 90, 200 140, 300 110 S 440 80, 520 120" />
      </g>
      <g fill="none" stroke="var(--f-wine)" stroke-width="1.2" opacity="0.4">
        <path d="M 30 240 C 80 190, 60 150, 110 110" />
      </g>
    </svg>
    <span class="f-coord">{featuredTrip.data.coordLabel}</span>
    <h1>{settings.heroTitle}</h1>
    <p>{settings.heroSubtitle}</p>
    <div class="f-hero-ctas">
      <a class="f-btn" href="#viajes">{settings.heroCtaLabel}</a>
      <WhatsAppButton
        number={settings.whatsappNumber}
        message="Hola Romi, quiero saber más del viaje a Mendoza"
        label="Escribinos por WhatsApp"
      />
    </div>
    <div class="f-meta">{settings.heroMeta}</div>
  </header>

  <section class="f-entry">
    <span class="f-entry-label">{settings.entryLabel}</span>
    <blockquote>"{settings.entryQuote}"</blockquote>
    <div class="f-sig">{settings.founderName}</div>
  </section>

  <section id="viajes">
    {tripsWithContent.length > 1 && (
      <span class="f-entry-label" style="display:block; margin-bottom:20px;">{settings.viajesLabel}</span>
    )}
    {tripsWithContent.map(({ trip, Content }) => (
      <TripCard trip={trip} Content={Content} />
    ))}
  </section>

  <section class="f-para-quien">
    <span class="f-entry-label">{settings.paraQuienLabel}</span>
    <p>{settings.paraQuienText}</p>
    <div class="f-tags">
      {settings.paraQuienTags.map((tag) => <span class="f-tag-pill">{tag}</span>)}
    </div>
  </section>

  <section class="f-about" id="sobre-romi">
    <div class="f-about-head">
      <h2>{settings.aboutLabel}</h2>
      <span class="f-entry-label">{settings.aboutSubLabel}</span>
    </div>
    {settings.founderPhoto && (
      <div class="f-polaroid f-about-photo">
        <div class="f-polaroid-inner">
          <img src={settings.founderPhoto} alt={settings.founderName} />
        </div>
      </div>
    )}
    {settings.aboutBio.map((paragraph) => <p>{paragraph}</p>)}
    <span class="f-sig">{settings.founderName}</span>
  </section>

  <section class="f-origin">
    <span class="f-entry-label">{settings.originCoordLabel}</span>
    <p style="margin-top:12px;">{settings.originText}</p>
    <span class="f-origin-price">{settings.originPrice}</span>
  </section>

  <section>
    <span class="f-entry-label" style="display:block; margin-bottom:12px;">{settings.principlesLabel}</span>
    <div class="f-principles">
      {settings.principles.map((p) => (
        <div class="f-principle">
          <span class="tag">{p.tag}</span>
          <p>{p.text}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="f-faq" id="faq">
    <span class="f-entry-label" style="display:block; margin-bottom:6px;">{settings.faqLabel}</span>
    <h2 style="margin-bottom:18px;">{settings.faqTitle}</h2>
    {settings.faq.map((item) => (
      <div class="f-faq-item">
        <p class="f-faq-q">{item.q}</p>
        <p class="f-faq-a">{item.a}</p>
      </div>
    ))}
    {settings.faqNote && <p class="f-faq-note">{settings.faqNote}</p>}
  </section>

  <section class="f-contact" id="contacto">
    <h2>{settings.contactLabel}</h2>
    <p>{settings.contactText}</p>
    <div class="f-contact-grid">
      <div class="f-contact-direct">
        <span class="f-entry-label">{settings.contactDirectLabel}</span>
        <span class="f-phone">{settings.phoneLabel}</span>
        <WhatsAppButton
          number={settings.whatsappNumber}
          message="Hola Romi, tengo una consulta"
          label="Escribinos por WhatsApp"
        />
      </div>
      <form class="f-form" action="/api/submit" method="POST">
        <input type="hidden" name="_tipo" value="contacto" />
        <input type="hidden" name="_next_hash" value="contacto" />
        <p style="display:none;"><label>No llenar: <input name="_honey" /></label></p>
        <input type="text" name="nombre" placeholder={settings.contactNamePlaceholder} aria-label="Nombre" required />
        <input type="email" name="email" placeholder={settings.contactEmailPlaceholder} aria-label="Email" required />
        <textarea name="mensaje" placeholder={settings.contactMessagePlaceholder} aria-label="Mensaje" required></textarea>
        <button type="submit" class="f-btn f-btn-outline">{settings.contactSubmitLabel}</button>
      </form>
    </div>
  </section>

  <Newsletter />

  <SiteFooter />

  <WhatsAppButton number={settings.whatsappNumber} message="Hola Romi, quiero saber más" float />
</Layout>
