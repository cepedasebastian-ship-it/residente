---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import SiteNav from '../../components/SiteNav.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import Newsletter from '../../components/Newsletter.astro';
import WhatsAppButton from '../../components/WhatsAppButton.astro';
import settings from '../../data/settings.json';

export async function getStaticPaths() {
  const trips = await getCollection('trips');
  return trips.map((trip) => ({ params: { id: trip.id }, props: { trip } }));
}

const { trip } = Astro.props;
const { data, id } = trip;
const { Content } = await render(trip);

const showSpots = typeof data.capacityTotal === 'number' && data.capacityTotal > 0 && typeof data.spotsTaken === 'number';
const spotsPct = showSpots ? Math.min(100, Math.round((data.spotsTaken! / data.capacityTotal!) * 100)) : 0;

const otherTrips = (await getCollection('trips')).filter((t) => t.id !== id).sort((a, b) => a.data.order - b.data.order);
const relatedTrip = otherTrips[0];

const touristTripSchema = {
  '@context': 'https://schema.org',
  '@type': 'TouristTrip',
  name: data.title,
  description: data.includesLabel,
  image: new URL(data.coverImage.src, Astro.site).toString(),
  touristType: data.badge,
  itinerary: data.itinerary.map((stop) => ({
    '@type': 'TouristAttraction',
    name: stop.title,
    description: stop.description,
  })),
};
---

<Layout
  title={`${data.title} — Experiencia Residente`}
  description={data.includesLabel}
  ogImage={data.coverImage}
  structuredData={touristTripSchema}
>
  <SiteNav />

  <a class="f-back-link" href="/#viajes">{settings.backToTripsLabel}</a>

  <div class="f-trip-grid">
    <div class="f-trip-media">
      <div class="f-tape-strip"></div>
      <div class="f-polaroid">
        <div class="f-polaroid-inner">
          <Image src={data.coverImage} alt={data.coverAlt} width={720} height={540} />
        </div>
        <div class="f-polaroid-cap">{data.coverCaption}</div>
      </div>

      {data.gallery && data.gallery.length > 0 && (
        <div class="f-gallery-row">
          {data.gallery.map((item, i) => (
            <div class={`f-polaroid f-polaroid-sm ${i % 2 === 0 ? 'f-rotate-left' : 'f-rotate-right'}`}>
              <div class="f-polaroid-inner">
                <Image src={item.photo} alt={item.caption || data.title} width={360} height={270} />
              </div>
              {item.caption && <div class="f-polaroid-cap">{item.caption}</div>}
            </div>
          ))}
        </div>
      )}
    </div>

    <section class="f-card">
      <span class="f-coord">{data.coordLabel}</span>
      <div class="f-card-top" style="margin-top:14px;">
        <span class="f-stamp-badge">{data.badge}</span>
        <span class="f-date-tag">
          {data.durationLabel}<br />
          {data.dateLabel}<br />
          {data.capacityLabel}
        </span>
      </div>
      {showSpots && (
        <div class="f-spots-row">
          <span class="f-spots-bar"><span style={`width:${spotsPct}%`}></span></span>
          <span class="f-spots-label">{data.spotsTaken} de {data.capacityTotal} lugares ocupados</span>
        </div>
      )}
      <h1>{data.title}</h1>
      <div class="f-desc f-desc-wide">
        <Content />
      </div>
      <div class="f-price-row">
        <div class="f-price-item">
          <span class="f-price-label">Duración</span>
          <span class="f-price-value">{data.durationLabel}</span>
        </div>
        <div class="f-price-item">
          <span class="f-price-label">Incluye</span>
          <span class="f-price-value">{data.includesLabel}</span>
        </div>
        <div class="f-price-item">
          <span class="f-price-label">Valor</span>
          <span class="f-price-value">{data.priceLabel}</span>
        </div>
      </div>
      <ul class="f-list">
        {data.includes.map((item: string) => <li>{item}</li>)}
      </ul>
    </section>
  </div>

  {data.itinerary && data.itinerary.length > 0 && (
    <section class="f-itinerary">
      <span class="f-entry-label" style="display:block; margin-bottom:16px;">{settings.itineraryLabel}</span>
      <div class="f-itinerary-grid">
        {data.itinerary.map((stop) => (
          <div class="f-itinerary-stop">
            <span class="f-itinerary-day">{stop.day}</span>
            <h3>{stop.title}</h3>
            <p>{stop.description}</p>
          </div>
        ))}
      </div>
    </section>
  )}

  {relatedTrip && (
    <section class="f-related">
      <span class="f-entry-label" style="display:block; margin-bottom:14px;">{settings.relatedTripsLabel}</span>
      <a class="f-related-card" href={`/viajes/${relatedTrip.id}`}>
        <div class="f-related-photo">
          <Image src={relatedTrip.data.coverImage} alt={relatedTrip.data.coverAlt} width={240} height={180} />
        </div>
        <div class="f-related-copy">
          <span class="f-related-eyebrow">{relatedTrip.data.coordLabel}</span>
          <h3>{relatedTrip.data.title}</h3>
        </div>
        <span class="f-related-link">{settings.viewTripLabel}</span>
      </a>
    </section>
  )}

  <section class="f-card" id="anotarme">
    <h2>{settings.waitlistTitle}</h2>
    <p class="f-desc">{settings.waitlistText}</p>
    <form class="f-waitlist" action="/api/submit" method="POST">
      <input type="hidden" name="_tipo" value="lista-de-espera" />
      <input type="hidden" name="viaje" value={data.title} />
      <input type="hidden" name="_next_hash" value={id} />
      <p style="display:none;"><label>No llenar: <input name="_honey" /></label></p>
      <input type="email" name="email" placeholder={settings.contactEmailPlaceholder} aria-label="Email para la lista de espera" required />
      <button type="submit" class="f-btn">{settings.waitlistButtonLabel}</button>
    </form>
    <p class="f-form-note">{settings.waitlistPriceNote}</p>
    <div style="margin-top:20px;">
      <WhatsAppButton
        number={settings.whatsappNumber}
        message={`Hola Romi, quiero saber más del viaje: ${data.title}`}
        label="Escribinos por WhatsApp"
      />
    </div>
  </section>

  <a class="f-back-link" href="/#viajes">{settings.backToTripsLabel}</a>

  <Newsletter />

  <SiteFooter />

  <WhatsAppButton number={settings.whatsappNumber} message="Hola Romi, quiero saber más" float />
</Layout>
