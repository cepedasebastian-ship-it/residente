---
import settings from '../data/settings.json';
---

<footer class="f-footer">
  <a href="/" aria-label="Ir al inicio" class="f-brand">
    <img
      src={settings.logoImage}
      alt="Experiencia Residente"
      style={`width:${settings.logoFooterWidth}px; height:auto;`}
      class="f-brand-lockup"
    />
  </a>
  <a class="f-foot-meta" href={settings.instagramUrl} target="_blank" rel="noopener">{settings.footerHandle}</a>
</footer>
