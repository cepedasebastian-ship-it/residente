---
import { getCollection } from 'astro:content';
import settings from '../data/settings.json';

const trips = (await getCollection('trips')).sort((a, b) => a.data.order - b.data.order);
---

<div class="f-nav">
  <a href="/" aria-label="Ir al inicio" class="f-brand">
    <img
      src={settings.logoImage}
      alt="Experiencia Residente"
      style={`width:${settings.logoHeaderWidth}px; height:auto;`}
      class="f-brand-lockup"
    />
  </a>
  <details class="f-nav-toggle" open>
    <summary class="f-nav-toggle-btn" aria-label="Abrir menú">
      <span class="f-burger"></span>
    </summary>
    <div class="f-nav-links">
      {trips.map((trip) => <a href={`/viajes/${trip.id}`}>{trip.data.navLabel}</a>)}
      <a href="/#sobre-romi">{settings.navAboutLabel}</a>
      <a href="/cuaderno">{settings.navJournalLabel}</a>
      <a href="/#faq">{settings.navFaqLabel}</a>
      <a href="/#contacto">{settings.navContactLabel}</a>
    </div>
  </details>
</div>

<script is:inline>
  (function () {
    var toggle = document.currentScript.previousElementSibling.querySelector('.f-nav-toggle');
    if (!toggle) return;
    if (window.innerWidth <= 640) {
      toggle.removeAttribute('open');
    }
    toggle.querySelectorAll('a').forEach(function (link) {
      link.addEventListener('click', function () {
        if (window.innerWidth <= 640) toggle.removeAttribute('open');
      });
    });
  })();
</script>
