---
import { getCollection } from 'astro:content';

const trips = (await getCollection('trips')).sort((a, b) => a.data.order - b.data.order);
---

<div class="f-nav">
  <a href="/" aria-label="Ir al inicio" class="f-brand">
    <img src="/logo-lockup-vino.svg" alt="Experiencia Residente" width="170" height="62" class="f-brand-lockup" />
  </a>
  <div class="f-nav-links">
    {trips.map((trip) => <a href={`/#${trip.id}`}>{trip.data.navLabel}</a>)}
    <a href="/#sobre-romi">Sobre Romi</a>
    <a href="/#faq">FAQ</a>
    <a href="/#contacto">Contacto</a>
  </div>
</div>
