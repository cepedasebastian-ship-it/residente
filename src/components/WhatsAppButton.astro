---
interface Props {
  number: string;
  message: string;
  label?: string;
  float?: boolean;
}

const { number, message, label = 'Escribinos por WhatsApp', float = false } = Astro.props;
const href = `https://wa.me/${number}?text=${encodeURIComponent(message)}`;
---

{
  float ? (
    <a class="f-whatsapp-float" href={href} target="_blank" rel="noopener" aria-label={label}>
      <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
        <path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.45 1.32 4.95L2.05 22l5.25-1.38c1.45.79 3.08 1.21 4.74 1.21h.01c5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.82 9.82 0 0 0 12.04 2zm5.8 14.09c-.24.68-1.4 1.32-1.93 1.4-.51.08-1.15.11-1.86-.12-.43-.13-.98-.32-1.68-.62-2.96-1.28-4.89-4.25-5.04-4.45-.15-.2-1.21-1.61-1.21-3.07 0-1.46.77-2.17 1.04-2.47.27-.3.6-.37.8-.37.2 0 .4 0 .58.01.19.01.44-.07.68.53.24.6.83 2.06.9 2.21.07.15.12.33.02.53-.1.2-.15.32-.3.5-.15.18-.31.4-.44.53-.15.15-.3.31-.13.61.17.3.76 1.27 1.63 2.05 1.12 1.01 2.06 1.33 2.36 1.48.3.15.48.13.65-.08.18-.2.75-.87.95-1.17.2-.3.4-.25.68-.15.28.1 1.77.85 2.07 1 .3.15.5.23.58.36.07.13.07.75-.17 1.43z" />
      </svg>
    </a>
  ) : (
    <a class="f-btn f-btn-whatsapp" href={href} target="_blank" rel="noopener">
      {label}
    </a>
  )
}
